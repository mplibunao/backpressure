{
  "name": "@mplibunao/tsconfig",
  "version": "0.0.0",
  "description": "Strict shared TypeScript configs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mplibunao/backpressure.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "base.json",
    "server.json",
    "browser.json",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./server.json": "./server.json",
    "./browser.json": "./browser.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack:dry-run": "node ../../scripts/packages/tsconfig/check-package-allowlist.ts",
    "pack:dry-run:no-build": "node ../../scripts/packages/tsconfig/check-package-allowlist.ts"
  }
}
