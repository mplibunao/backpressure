{
  "name": "@mplibunao/tsconfig",
  "version": "0.1.0",
  "description": "Strict shared TypeScript configs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mplibunao/backpressure.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "base.json",
    "server.json",
    "browser.json",
    "effect.json",
    "effect-tsc.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./server.json": "./server.json",
    "./browser.json": "./browser.json",
    "./effect.json": "./effect.json",
    "./effect-tsc.json": "./effect-tsc.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack:dry-run": "bun ../../scripts/packages/tsconfig/check-package-allowlist.ts",
    "pack:dry-run:no-build": "bun ../../scripts/packages/tsconfig/check-package-allowlist.ts"
  },
  "peerDependencies": {
    "@effect/tsgo": "0.46.1"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
