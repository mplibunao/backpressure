{
  "name": "@mplibunao/oxlint-standards",
  "version": "0.0.0",
  "description": "Opinionated oxlint JS-plugin presets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mplibunao/backpressure.git",
    "directory": "packages/oxlint-standards"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -b tsconfig.build.json --force",
    "pack:dry-run": "pnpm build && npm --cache ../../.npm-cache pack --dry-run",
    "typecheck": "tsc -b"
  }
}
