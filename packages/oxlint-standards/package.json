{
  "name": "@mplibunao/oxlint-standards",
  "version": "0.1.0",
  "description": "Opinionated oxlint JS-plugin presets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mplibunao/backpressure.git",
    "directory": "packages/oxlint-standards"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "pack:dry-run": "bun ../../scripts/packages/oxlint-standards/check-package-allowlist.ts",
    "pack:dry-run:no-build": "SKIP_BUILD=true bun ../../scripts/packages/oxlint-standards/check-package-allowlist.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@effect/tsgo": "0.46.1",
    "oxlint": "^1.58.0"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    }
  }
}
