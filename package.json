{
  "name": "backpressure",
  "version": "0.0.0",
  "private": true,
  "description": "MP's monorepo for homegrown code-quality backpressure tooling.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm versions:check && pnpm typecheck && pnpm test && pnpm build && pnpm check-release-workflow && SKIP_BUILD=true pnpm inventory:rules && SKIP_BUILD=true pnpm fixture:replay && SKIP_BUILD=true pnpm smoke:oxlint-packed-consumer && pnpm smoke:tsconfig-packed-consumer && pnpm -r --if-present pack:dry-run:no-build && pnpm prose",
    "check:fix": "vp check --fix",
    "fixture:replay": "node scripts/fixture-replay.ts",
    "inventory:rules": "node scripts/check-rule-inventory.ts",
    "fmt": "vp fmt",
    "format": "pnpm fmt",
    "lint": "vp lint --max-warnings 0",
    "oxlint:package:allowlist": "node scripts/check-oxlint-package-allowlist.ts",
    "check-release-workflow": "node scripts/check-release-workflow.ts",
    "pack:dry-run": "pnpm -r --if-present pack:dry-run",
    "prepare": "vp config",
    "prose": "pnpm prose:files",
    "prose:commit": "scripts/prose-commit.sh",
    "prose:files": "scripts/prose-files.sh",
    "prose:sync": "scripts/vale-ensure-styles.sh",
    "smoke:oxlint-packed-consumer": "node scripts/smoke-oxlint-packed-consumer.ts",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run",
    "typecheck": "tsc -b",
    "versions:check": "node scripts/version-pins.ts",
    "tsconfig:package:allowlist": "node scripts/check-tsconfig-package-allowlist.ts",
    "smoke:tsconfig-packed-consumer": "node scripts/smoke-tsconfig-packed-consumer.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.4.0"
}
